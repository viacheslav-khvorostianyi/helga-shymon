[Unit]
Description=helga-shymon Flask app (gunicorn)
After=network.target

[Service]
User=helga
Group=helga
WorkingDirectory=/opt/helga
EnvironmentFile=/opt/helga/.env
ExecStart=/opt/helga/.venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 --access-logfile - run:app
Restart=always

[Install]
WantedBy=multi-user.target
